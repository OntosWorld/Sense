{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sense-sdk.github.io/schemas/context-1.0.schema.json",
  "title": "Sense Context Snapshot",
  "description": "Serialized machine context produced by the Sense SDK. Language-neutral.",
  "version": "1.0",
  "type": "object",
  "required": [
    "schema_version",
    "machine",
    "generated_at",
    "observations",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema identifier. Must be '1.0' for this version."
    },
    "machine": {
      "type": "object",
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Developer-assigned machine reference."
        },
        "peaq_did": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional peaq decentralized identifier."
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 generation timestamp (UTC)."
    },
    "latest_observation_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "ISO 8601 timestamp of the most recent observation."
    },
    "state": {
      "type": "object",
      "description": "Flat map of path → current value for quick access.",
      "additionalProperties": {}
    },
    "observations": {
      "type": "array",
      "description": "List of all telemetry observations.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "value",
          "observed_at"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$",
            "description": "Dot-notation telemetry path."
          },
          "value": {
            "description": "Observation value. May be any JSON type."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the observation."
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the SDK received the observation."
          },
          "source": {
            "type": "string",
            "description": "Optional label identifying the observation source."
          },
          "ttl_ms": {
            "type": "number",
            "minimum": 0,
            "description": "Time-to-live in milliseconds; null means no expiry."
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Evaluated capability statuses keyed by capability name.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "blocking",
          "warnings",
          "unknown_paths",
          "reasons"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "DEGRADED",
              "UNAVAILABLE",
              "UNKNOWN"
            ],
            "description": "Capability status at generation time."
          },
          "blocking": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "severity",
                "path",
                "expected"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Machine-readable reason code."
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "blocking",
                    "warning"
                  ],
                  "description": "Constraint severity."
                },
                "path": {
                  "type": "string",
                  "description": "Observation path this reason refers to."
                },
                "expected": {
                  "type": "string",
                  "description": "Human-readable expected condition."
                },
                "observed": {
                  "description": "Observed JSON value, if publication policy includes it."
                },
                "observed_age_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Age of evidence at evaluation time."
                }
              },
              "additionalProperties": false
            },
            "description": "Failed blocking constraints."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "severity",
                "path",
                "expected"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Machine-readable reason code."
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "blocking",
                    "warning"
                  ],
                  "description": "Constraint severity."
                },
                "path": {
                  "type": "string",
                  "description": "Observation path this reason refers to."
                },
                "expected": {
                  "type": "string",
                  "description": "Human-readable expected condition."
                },
                "observed": {
                  "description": "Observed JSON value, if publication policy includes it."
                },
                "observed_age_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Age of evidence at evaluation time."
                }
              },
              "additionalProperties": false
            },
            "description": "Active degradation constraints."
          },
          "unknown_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Evidence paths that are missing or stale."
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "severity",
                "path",
                "expected"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Machine-readable reason code."
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "blocking",
                    "warning"
                  ],
                  "description": "Constraint severity."
                },
                "path": {
                  "type": "string",
                  "description": "Observation path this reason refers to."
                },
                "expected": {
                  "type": "string",
                  "description": "Human-readable expected condition."
                },
                "observed": {
                  "description": "Observed JSON value, if publication policy includes it."
                },
                "observed_age_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Age of evidence at evaluation time."
                }
              },
              "additionalProperties": false
            },
            "description": "Combined blocking and warning reasons."
          }
        },
        "additionalProperties": false
      }
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional distributed-trace identifier."
    }
  },
  "additionalProperties": false
}
