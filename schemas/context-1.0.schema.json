{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sense-sdk.github.io/schemas/context-1.0.schema.json",
  "title": "Sense Context Snapshot",
  "description": "Serialized machine context produced by the Sense SDK. Language-neutral.",
  "version": "1.0",
  "type": "object",
  "required": ["schemaVersion", "machineRef", "timestamp", "latestObservationAt", "observations"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Schema identifier. Must be '1.0' for this version."
    },
    "machineRef": {
      "type": "string",
      "minLength": 1,
      "description": "Developer-assigned machine reference."
    },
    "peaqDid": {
      "type": "string",
      "description": "Optional peaq decentralized identifier."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 evaluation timestamp."
    },
    "latestObservationAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the most recent observation."
    },
    "observations": {
      "type": "object",
      "description": "Map of path → TelemetryObservation.",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "value", "observedAt"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
          },
          "value": {},
          "observedAt": { "type": "string", "format": "date-time" },
          "receivedAt": { "type": "string", "format": "date-time" },
          "source": { "type": "string" },
          "ttlMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "redactedPaths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths omitted from observations for privacy."
    },
    "metadata": {
      "type": "object",
      "description": "Optional developer-supplied metadata."
    }
  },
  "additionalProperties": false
}
