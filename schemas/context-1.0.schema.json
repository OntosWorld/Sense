{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OntosWorld/Sense/blob/main/schemas/context-1.0.schema.json",
  "title": "Sense Context Snapshot",
  "description": "Language-neutral machine context produced by the Sense SDK.",
  "version": "1.0",
  "type": "object",
  "required": [
    "schema_version",
    "machine",
    "generated_at",
    "observations",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "machine": {
      "type": "object",
      "required": ["ref", "peaq_did"],
      "properties": {
        "ref": {
          "type": ["string", "null"]
        },
        "peaq_did": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "latest_observation_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "value", "observed_at"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
          },
          "value": {},
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "ttl_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "reasons"],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "DEGRADED",
              "UNAVAILABLE",
              "UNKNOWN"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "severity",
                "path",
                "expected"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": ["blocking", "warning"]
                },
                "path": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "observed": {},
                "observed_age_ms": {
                  "type": ["integer", "null"]
                },
                "constraint_name": {
                  "type": ["string", "null"]
                },
                "is_absent": {
                  "type": "boolean"
                },
                "is_stale": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "unknown_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "trace_id": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
